{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "if": {
    "properties": {"leaderElection": {"properties": {"enabled": {"const": false}}}}
  },
  "then": {
    "properties": {"replicaCount": {"maximum": 1}}
  },
  "definitions": {
    "stringMap": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {"name": {"type": "string", "minLength": 1}}
      }
    },
    "enabled": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"}
      }
    }
  },
  "properties": {
    "global": {"type": "object"},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {"type": "array"},
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "crds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install": {"type": "boolean"}
      }
    },
    "replicaCount": {"type": "integer", "minimum": 1},
    "leaderElection": {"$ref": "#/definitions/enabled"},
    "maxConcurrentReconciles": {"type": "integer", "minimum": 1},
    "timezone": {"type": "string", "minLength": 1},
    "resources": {"type": "object"},
    "nodeSelector": {"$ref": "#/definitions/stringMap"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"},
    "podAnnotations": {"$ref": "#/definitions/stringMap"},
    "podLabels": {"$ref": "#/definitions/stringMap"},
    "priorityClassName": {"type": "string"},
    "extraEnv": {"$ref": "#/definitions/env"},
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "not": {"anyOf": [{"const": 8081}, {"minimum": 20000, "maximum": 29999}]}
        },
        "secure": {"type": "boolean"},
        "readerSubjects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "name"],
            "if": {"properties": {"kind": {"const": "ServiceAccount"}}},
            "then": {"required": ["namespace"], "properties": {"namespace": {"minLength": 1}}},
            "additionalProperties": false,
            "properties": {
              "kind": {"enum": ["ServiceAccount", "User", "Group"]},
              "apiGroup": {"type": "string"},
              "name": {"type": "string", "minLength": 1},
              "namespace": {"type": "string"}
            }
          }
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "interval": {"type": "string", "minLength": 1},
            "additionalLabels": {"$ref": "#/definitions/stringMap"}
          }
        },
        "prometheusRule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "additionalLabels": {"$ref": "#/definitions/stringMap"}
          }
        }
      }
    },
    "prometheus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {"type": "string", "pattern": "^(https?://.+)?$"}
      }
    },
    "watchNamespaces": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "protectedNamespaces": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "idleAfter": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
          "anyOf": [
            {"pattern": "(^|[a-zµ])0*[1-9][0-9]*(\\.[0-9]+)?h"},
            {"pattern": "(^|[a-zµ])0*[1-9][0-9]*(\\.[0-9]+)?m([0-9]|$)"},
            {"pattern": "(^|[a-zµ])0*([6-9][0-9]|[1-9][0-9]{2,})(\\.[0-9]+)?s([0-9]|$)"}
          ]
        },
        "cpuThreshold": {"type": "integer", "minimum": 1, "maximum": 100},
        "dryRun": {"type": "boolean"}
      }
    },
    "doorman": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "replicaCount": {"type": "integer", "minimum": 1},
        "healthCheckUserAgents": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "pattern": "^[^,]+$"}
        },
        "portsPerWorkload": {"type": "integer", "minimum": 1, "maximum": 10000},
        "portsPerNamespace": {"type": "integer", "minimum": 1, "maximum": 10000},
        "admissionPolicy": {"$ref": "#/definitions/enabled"},
        "podDisruptionBudget": {"$ref": "#/definitions/enabled"},
        "nodeSelector": {"$ref": "#/definitions/stringMap"},
        "tolerations": {"type": "array"},
        "affinity": {"type": "object"},
        "podAnnotations": {"$ref": "#/definitions/stringMap"},
        "podLabels": {"$ref": "#/definitions/stringMap"},
        "priorityClassName": {"type": "string"},
        "extraEnv": {"$ref": "#/definitions/env"},
        "topologySpreadConstraints": {"type": "array"},
        "resources": {"type": "object"},
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ingressFrom": {"type": "array", "items": {"type": "object", "minProperties": 1}},
            "egress": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean"},
                "podCIDRs": {"type": "array", "items": {"type": "string", "minLength": 1}},
                "apiServer": {"type": "array", "items": {"type": "string", "minLength": 1}},
                "apiServerPorts": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "integer", "minimum": 1, "maximum": 65535}
                }
              }
            }
          }
        }
      }
    },
    "networkPolicy": {"$ref": "#/definitions/enabled"},
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uninstall": {"type": "boolean"},
        "upgrade": {"type": "boolean"},
        "nodeSelector": {"$ref": "#/definitions/stringMap"},
        "tolerations": {"type": "array"},
        "affinity": {"type": "object"},
        "priorityClassName": {"type": "string"},
        "podAnnotations": {"$ref": "#/definitions/stringMap"},
        "podLabels": {"$ref": "#/definitions/stringMap"},
        "resources": {"type": "object"}
      }
    },
    "logLevel": {
      "anyOf": [
        {"enum": ["debug", "info", "error", "panic"]},
        {"type": "integer", "minimum": 1}
      ]
    },
    "logEncoder": {"enum": ["json", "console"]}
  }
}
